<p class="p1"><span class="s1"><span class="Apple-converted-space">                </span>const btn = document.getElementById(`nav-${r}`);</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">                </span>if (r === role) {</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">                    </span>btn.classList.add('bg-gray-800', 'text-white', 'border-gray-600');</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">                    </span>btn.classList.remove('text-gray-400');</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">                </span>} else {</span></p>
