<p class="p1"><span class="s1"><span class="Apple-converted-space">        </span>// --- Role Switching Logic ---</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">        </span>window.switchRole = function(role) {</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">            </span>const names = {</span></p>
<p class="p1"><span class="s1"><span class="Apple-converted-space">                </span>'admin': 'Администратор',</span></p>
